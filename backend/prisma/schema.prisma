// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Auth0 user ID, e.g. auth0|abc123
  email     String?
  name      String?
  picture   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  transactions          Transaction[]
  splits                Split[]
  purchases             Purchase[]
  income_settings       IncomeSetting[]
  bank_connections      BankConnection[]
  bank_accounts         BankAccount[]
  bank_balance_snapshots BankBalanceSnapshot[]
  user_plan             UserPlan?
  bank_connection_usage BankConnectionUsage[]

  @@map("users")
}

model Transaction {
  id          String   @id
  user_id     String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  category    String?
  description String?
  source      String   @default("manual") // 'bank' or 'manual'
  // Bank-sync fields — null for manual/CSV transactions
  bank_account_id         String?
  provider                String?
  provider_transaction_id String?
  created_at  DateTime @default(now())
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)
  // Dedup: a partial unique index (uq_bank_sync_dedup) is created by SQL migration.
  // Manual/CSV transactions (provider_transaction_id = null) are never affected by it.
  @@index([user_id])
  @@index([user_id, source])
  @@index([bank_account_id])
  @@index([user_id, provider, provider_transaction_id])
  @@map("transactions")
}

model Split {
  id         String   @id
  user_id    String
  name       String
  frequency  String
  categories Json     // Array of category strings; stored as jsonb in Postgres
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@map("splits")
}

model Purchase {
  id             String   @id
  user_id        String
  split_id       String
  transaction_id String?
  date           DateTime
  amount         Decimal  @db.Decimal(12, 2)
  category       String
  description    String?
  created_at     DateTime @default(now())
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@index([split_id])
  @@index([user_id, split_id])
  @@index([user_id, date])
  @@index([user_id, split_id, date])
  @@map("purchases")
}

model IncomeSetting {
  id                          String   @id
  user_id                     String
  split_id                    String   @unique
  expected_amount             Decimal  @db.Decimal(12, 2) @default(0)
  frequency                   String   @default("monthly")
  next_payday                 String?
  use_expected_when_no_actual Boolean  @default(true)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @default(now()) @updatedAt
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@map("income_settings")
}

// TrueLayer Open Banking Integration
model BankConnection {
  id                    String    @id @default(uuid())
  user_id               String
  provider              String    @default("truelayer")
  // Access token: encrypted at rest. Plaintext column is nullable for backward compatibility;
  // new connections write to encrypted_access_token and clear this field.
  access_token            String?
  encrypted_access_token  String?
  access_token_iv         String?
  access_token_tag        String?
  encrypted_refresh_token String?
  refresh_token_iv      String?
  refresh_token_tag     String?
  token_expires_at      DateTime?
  created_at            DateTime  @default(now())
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([user_id, provider], name: "user_id_provider")
  @@index([user_id])
  @@map("bank_connections")
}

model BankAccount {
  id                  String   @id @default(uuid())
  user_id             String
  provider            String   @default("truelayer")
  provider_account_id String
  account_name        String?
  currency            String?
  balance             Decimal? @db.Decimal(12, 2)
  available_balance   Decimal? @db.Decimal(12, 2)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  @@unique([user_id, provider, provider_account_id], name: "user_id_provider_provider_account_id")
  @@index([user_id])
  @@map("bank_accounts")
}

model BankBalanceSnapshot {
  id              String   @id @default(uuid())
  user_id         String
  provider        String   @default("truelayer")
  total_balance     Decimal? @db.Decimal(12, 2)
  available_balance Decimal? @db.Decimal(12, 2)
  currency        String?
  account_name    String?
  provider_account_id String?
  synced_at       DateTime @default(now())
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([user_id, provider], name: "user_id_provider_balance")
  @@index([user_id])
  @@map("bank_balance_snapshots")
}

// Subscription tier system
model UserPlan {
  id                      String    @id @default(uuid())
  user_id                 String    @unique
  // NOTE: email is kept here for Stripe customer lookup convenience.
  // Source of truth for email is User.email. Do not remove without auditing stripe-webhook.js and billing.js.
  email                   String?
  plan                    String    @default("free") // free | plus | pro
  role                    String    @default("user") // user | admin
  stripe_customer_id      String?
  stripe_subscription_id  String?
  plan_status             String?   // active | trialing | past_due | canceled
  plan_current_period_end DateTime?
  started_at              DateTime  @default(now())
  expires_at              DateTime?
  cancelled_at            DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@index([stripe_subscription_id])
  @@map("user_plans")
}

model BankConnectionUsage {
  id               String   @id @default(uuid())
  user_id          String
  week_start       DateTime @db.Date  // Monday of ISO week
  connections_used Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([user_id, week_start])
  @@index([user_id, week_start])
  @@map("bank_connection_usage")
}

